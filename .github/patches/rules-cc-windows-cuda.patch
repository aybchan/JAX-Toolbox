+        clang_cl_include_directories += ",\n        " + json.encode(escape_string(cuda_include_path))
     write_builtin_include_directory_paths(repository_ctx, "clang-cl", [clang_cl_include_directories], file_suffix = "_clangcl")
     clang_cl_vars = {
