diff --git a/gpu/windows_cuda_redist.bzl b/gpu/windows_cuda_redist.bzl
new file mode 100644
--- /dev/null
+++ b/gpu/windows_cuda_redist.bzl
@@ -0,0 +1,184 @@
+"""Native Windows ARM64 CUDA imports from an explicitly staged local toolkit.
+
+The installer must write windows_cuda_versions.json in LOCAL_CUDA_PATH and
+LOCAL_CUDNN_PATH, mapping repository names to full component versions. This
+keeps version metadata tied to the downloaded distributions, not DLL guesses.
+"""
+
+_IMPORTS = {
+    "cuda_cublas": [("cublas", "cublas"), ("cublasLt", "cublasLt")],
+    "cuda_cudart": [("cudart", "cudart")],
+    "cuda_cufft": [("cufft", "cufft")],
+    "cuda_curand": [("curand", "curand")],
+    "cuda_cusolver": [("cusolver", "cusolver")],
+    "cuda_cusparse": [("cusparse", "cusparse")],
+    "cuda_cupti": [("cupti", "cupti")],
+    "cuda_nvrtc": [("nvrtc", "nvrtc")],
+    "cuda_nvjitlink": [("nvjitlink", "nvJitLink")],
+    "cuda_nvfatbin": [("nvfatbin", "nvfatbin")],
+    "cuda_nvml": [("nvml", "nvml")],
+    "cuda_cudnn": [("cudnn_main", "cudnn"), ("cudnn_ops", "cudnn_ops"),
+                   ("cudnn_cnn", "cudnn_cnn"), ("cudnn_adv", "cudnn_adv"),
+                   ("cudnn_graph", "cudnn_graph"),
+                   ("cudnn_engines_precompiled", "cudnn_engines_precompiled"),
+                   ("cudnn_engines_runtime_compiled", "cudnn_engines_runtime_compiled"),
+                   ("cudnn_heuristic", "cudnn_heuristic")],
+}
+
+_HEADER_PATTERNS = {
+    "cuda_cublas": ["include/cublas*.h"],
+    "cuda_cufft": ["include/cufft*.h"],
+    "cuda_curand": ["include/curand*"],
+    "cuda_cusolver": ["include/cusolver*.h"],
+    "cuda_cusparse": ["include/cusparse*.h"],
+    "cuda_cudnn": ["include/cudnn*.h"],
+    "cuda_cccl": ["include/cccl/**"],
+    "cuda_crt": ["include/crt/**"],
+    "cuda_nvcc": ["include/fatbinary_section.h", "include/nvPTXCompiler.h"],
+    "cuda_nvml": ["include/nvml.h"],
+    "cuda_nvtx": ["include/nvtx3/**", "include/nvToolsExt*.h"],
+    "cuda_nvrtc": ["include/nvrtc.h"],
+    "cuda_nvjitlink": ["include/nvJitLink.h"],
+    "cuda_nvptxcompiler": ["include/nvPTXCompiler.h"],
+    "cuda_nvfatbin": ["include/nvFatbin.h"],
+    "cuda_profiler_api": ["include/cuda_profiler_api.h"],
+}
+
+def _repo_name(ctx):
+    return getattr(ctx, "original_name", ctx.name).replace("+", "~").split("~")[-1]
+
+def _required(ctx, root, relative):
+    if not ctx.path(root + "/" + relative).exists:
+        fail("Windows ARM64 CUDA dependency missing: " + root + "/" + relative)
+    return relative
+
+def _library(name, deps):
+    return "cc_library(name = %r, deps = %r)\n" % (name, deps)
+
+def _filegroup(name, paths):
+    return "filegroup(name = %r, srcs = %r)\n" % (name, paths)
+
+def _import(ctx, root, name, basename, static = False):
+    path = _required(ctx, root, "lib/arm64/" + basename + ".lib")
+    if static:
+        return "cc_import(name = %r, static_library = %r)\n" % (name, path)
+    # The wheel uses the CUDA DLLs installed on the target machine. Linking
+    # uses real Windows import libraries; ELF stubs are never substituted.
+    return "cc_import(name = %r, interface_library = %r, system_provided = True)\n" % (name, path)
+
+def _headers(name):
+    prefix = "third_party/gpus/cuda/include"
+    strip = "include"
+    if name == "cuda_cudnn":
+        prefix = "third_party/gpus/cudnn"
+    elif name == "cuda_cupti":
+        prefix = "third_party/gpus/cuda/extras/CUPTI/include"
+    elif name == "cuda_nvml":
+        prefix = "third_party/gpus/cuda/nvml/include"
+    elif name == "cuda_cccl":
+        strip = "include/cccl"
+    patterns = _HEADER_PATTERNS.get(name, ["include/**"])
+    return (
+        "filegroup(name = 'header_list', srcs = glob(%r, allow_empty = True))\n" % patterns +
+        "cc_library(name = 'headers', hdrs = [':header_list'], " +
+        "include_prefix = %r, strip_include_prefix = %r, includes = [%r])\n" % (prefix, strip, strip)
+    )
+
+def create_windows_cuda_repository(ctx):
+    """Create native import targets. Called only for explicit local Windows builds."""
+    name = _repo_name(ctx)
+    header = 'load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")\npackage(default_visibility = ["//visibility:public"])\n'
+
+    # Never let unsupported collective libraries silently compile as no-ops.
+    # Consumers must exclude these dependencies in their Windows selects.
+    if name in ["nvidia_nvshmem", "cuda_nccl"]:
+        targets = ["nvshmem", "headers", "libnvshmem_device"] if name == "nvidia_nvshmem" else ["nccl", "headers"]
+        content = header
+        for target in targets:
+            content += "cc_library(name = %r, target_compatible_with = ['@platforms//:incompatible'])\n" % target
+        ctx.file("BUILD", content)
+        ctx.file("version.bzl", 'VERSION = ""\n')
+        return
+
+    env = "LOCAL_CUDNN_PATH" if name == "cuda_cudnn" else "LOCAL_CUDA_PATH"
+    root = ctx.getenv(env)
+    if not root:
+        fail(env + " is required for native Windows ARM64 CUDA")
+    if ctx.os.arch not in ["aarch64", "arm64"]:
+        fail("This local CUDA dependency configuration requires a Windows ARM64 host")
+
+    # Directory symlinks preserve the native compiler package layout. Never
+    # write extensionless executable aliases beneath these links.
+    for directory in ["include", "lib", "bin", "nvvm"]:
+        source = root + "/" + directory
+        if ctx.path(source).exists:
+            ctx.symlink(source, directory)
+
+    if name == "cuda_driver":
+        content = 'load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")\n' + header
+        content += 'bool_flag(name = "include_cuda_umd_libs", build_setting_default = False)\n'
+        content += 'config_setting(name = "cuda_umd_libs", flag_values = {":include_cuda_umd_libs": "true"})\n'
+        content += 'alias(name = "nvidia_driver", actual = "@cuda_cudart//:cuda_driver")\n'
+        for target in ["nvidia_ptxjitcompiler", "nvidia-ml"]:
+            content += "cc_library(name = %r, target_compatible_with = ['@platforms//:incompatible'])\n" % target
+        ctx.file("BUILD", content)
+        ctx.file("version.bzl", 'VERSION = ""\n')
+        return
+
+    if name == "cuda_culibos":
+        # cuLIBOS is a Unix static-runtime dependency. Windows cudart does not
+        # use it; making the target incompatible catches accidental selection.
+        content = header + "cc_library(name = 'culibos_static_library', target_compatible_with = ['@platforms//:incompatible'])\n"
+        ctx.file("BUILD", content)
+        ctx.file("version.bzl", 'VERSION = ""\n')
+        return
+
+    manifest_path = root + "/windows_cuda_versions.json"
+    if not ctx.path(manifest_path).exists:
+        fail("Missing staged CUDA component manifest: " + manifest_path)
+    versions = json.decode(ctx.read(manifest_path))
+    if name not in versions:
+        fail("No installed component version for " + name + " in " + manifest_path)
+    version = versions[name]
+    ctx.file("version.bzl", "VERSION = %r\n" % version.split(".")[0])
+    content = header + _headers(name)
+
+    for target, basename in _IMPORTS.get(name, []):
+        imported = target + "_shared_library"
+        content += _import(ctx, root, imported, basename)
+        deps = [":" + imported, ":headers"]
+        if target == "cublas":
+            deps += [":cublasLt"]
+        content += _library(target, deps)
+
+    if name == "cuda_cudart":
+        content += _import(ctx, root, "cuda_stub", "cuda")
+        content += _library("cuda_driver", [":cuda_stub"])
+        content += _import(ctx, root, "cudart_static_library", "cudart_static", static = True)
+        content += _import(ctx, root, "cudadevrt_static_library", "cudadevrt", static = True)
+        content += _filegroup("static", ["lib/arm64/cudart_static.lib"])
+        content += 'exports_files(["include/cuda.h"])\n'
+    elif name == "cuda_cudnn":
+        content += _library("cudnn", [":" + target for target, _ in _IMPORTS[name]])
+    elif name == "cuda_nvptxcompiler":
+        content += _import(ctx, root, "nvptxcompiler_static_library", "nvptxcompiler_static", static = True)
+        content += _library("nvptxcompiler", [":nvptxcompiler_static_library", ":headers"])
+    elif name == "cuda_nvcc":
+        for tool in ["nvcc", "nvdisasm", "nvlink", "fatbinary", "bin2c", "ptxas"]:
+            path = _required(ctx, root, "bin/" + tool + ".exe")
+            content += _filegroup(tool, [path])
+        content += 'exports_files(["bin/nvcc.exe"])\n'
+        content += 'filegroup(name = "bin", srcs = glob(["bin/**", "nvvm/bin/**"]))\n'
+        content += _filegroup("nvvm", [_required(ctx, root, "nvvm/libdevice/libdevice.10.bc")])
+        content += _filegroup("link_stub", [_required(ctx, root, "bin/crt/link.stub")])
+        content += _library("nvptxcompiler", ["@cuda_nvptxcompiler//:nvptxcompiler"])
+    elif name == "cuda_nvvm":
+        content += _filegroup("cicc", [_required(ctx, root, "nvvm/bin/cicc.exe")])
+        content += _filegroup("nvvm", [_required(ctx, root, "nvvm/libdevice/libdevice.10.bc")])
+        content += 'exports_files(["nvvm/bin/cicc.exe", "nvvm/libdevice/libdevice.10.bc"])\n'
+    elif name in ["cuda_nvdisasm", "cuda_nvprune"]:
+        tool = name[len("cuda_"):]
+        content += _filegroup(tool, [_required(ctx, root, "bin/" + tool + ".exe")])
+        content += "exports_files([%r])\n" % ("bin/" + tool + ".exe")
+
+    ctx.file("BUILD", content)
