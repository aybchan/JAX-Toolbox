+
+def _cuda_clang_copts(repository_ctx):
+    if repository_ctx.os.name.lower().startswith("windows"):
+        # clang-cl requires /clang: for these GCC-driver-only options. Keep
+        # -x cuda outside this forwarding mechanism because it is positional.
+        return [
