+    toolkit = get_host_environ(repository_ctx, "LOCAL_CUDA_PATH")
+    if not toolkit:
+        _auto_configure_fail("LOCAL_CUDA_PATH is required for Windows CUDA builds")
+    return [
+        "--cuda-path=" + toolkit.replace("\\", "/"),
+        # The installed Clang may predate this CUDA toolkit. PTX remains capped
+        # to the compiler/toolkit intersection by _get_cuda_ptx_version.
+        "--no-cuda-version-check",
