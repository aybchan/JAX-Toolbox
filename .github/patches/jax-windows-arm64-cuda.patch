+
+void* LookupMagmaSymbol(void* handle, const char* symbol) {
+#if defined(_WIN32)
+  return reinterpret_cast<void*>(
+      GetProcAddress(static_cast<HMODULE>(handle), symbol));
+#else
+  return dlsym(handle, symbol);
+#endif
+}
+
+void CloseMagmaLibrary(void* handle) {
+#if defined(_WIN32)
+  FreeLibrary(static_cast<HMODULE>(handle));
+#else
+  dlclose(handle);
+#endif
+}
