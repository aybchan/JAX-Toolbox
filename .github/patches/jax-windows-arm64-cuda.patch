+def initialize_windows_cuda_dll_search_path() -> None:
+  """Register toolkit DLL directories before importing CUDA extensions."""
+  if os.name != "nt":
+    return
+  # A top-level spec lookup does not execute the package, including when its
+  # __init__ calls this helper before importing CUDA extensions.
+  bundled_nccl = False
+  spec = importlib.util.find_spec("jax_cuda13_plugin")
+  if spec is not None and spec.submodule_search_locations:
+    for location in spec.submodule_search_locations:
+      directory = pathlib.Path(location).resolve()
+      if not (directory / "nccl.dll").is_file():
+        continue
+      bundled_nccl = True
+      if directory not in _windows_cuda_dll_directories:
+        _windows_cuda_dll_directories[directory] = os.add_dll_directory(
+            str(directory)
+        )
+  # Installers can put cuDNN beneath a versioned bin/<version>/arm64 folder.
+  # Register the explicit leaf directory in every interpreter, including tests'
+  # subprocesses, before importing extensions that depend on cuDNN.
+  cudnn_bin = os.environ.get("CUDNN_BIN_PATH")
+  if cudnn_bin:
+    directory = pathlib.Path(cudnn_bin).resolve()
+    if directory.is_dir() and directory not in _windows_cuda_dll_directories:
+      _windows_cuda_dll_directories[directory] = os.add_dll_directory(
+          str(directory)
+      )
+  for variable in ("CUDA_PATH", "CUDNN_PATH", "NCCL_PATH", "CUPTI_PATH"):
+    # AddDllDirectory does not define ordering between registered directories.
+    if variable == "NCCL_PATH" and bundled_nccl:
+      continue
+    root = os.environ.get(variable)
+    if not root:
+      continue
+    for relative in ("bin", "bin/arm64", "lib/arm64"):
+      directory = pathlib.Path(root).resolve() / relative
+      if directory.is_dir() and directory not in _windows_cuda_dll_directories:
+        _windows_cuda_dll_directories[directory] = os.add_dll_directory(
+            str(directory)
+        )
 
 
