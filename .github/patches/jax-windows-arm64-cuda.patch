 namespace ffi = ::xla::ffi;
 
+namespace {
+void* OpenMagmaLibrary(const char* path) {
+#if defined(_WIN32)
+  if (path != nullptr) return LoadLibraryA(path);
+  HMODULE module = nullptr;
+  // Retain a reference, matching the destructor's FreeLibrary call.
+  GetModuleHandleExA(0, nullptr, &module);
+  return module;
+#else
+  return dlopen(path, RTLD_LAZY);
+#endif
+}
+
+void* LookupMagmaSymbol(void* handle, const char* symbol) {
+#if defined(_WIN32)
+  return reinterpret_cast<void*>(
+      GetProcAddress(static_cast<HMODULE>(handle), symbol));
+#else
+  return dlsym(handle, symbol);
+#endif
+}
+
+void CloseMagmaLibrary(void* handle) {
+#if defined(_WIN32)
+  FreeLibrary(static_cast<HMODULE>(handle));
+#else
+  dlclose(handle);
+#endif
+}
